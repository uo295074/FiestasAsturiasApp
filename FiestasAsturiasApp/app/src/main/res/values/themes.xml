<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 🎨 BASE THEME -->
    <style name="Base.Theme.FiestasAsturiasApp" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- PRIMARY -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>

        <!-- SECONDARY -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/onSecondary</item>

        <!-- BACKGROUND -->
        <item name="android:colorBackground">@color/background</item>

        <!-- SURFACE -->
        <item name="colorSurface">@color/surface</item>

        <!-- STATUS BAR -->
        <item name="android:statusBarColor">@color/primaryVariant</item>

        <!-- BOTONES -->
        <item name="materialButtonStyle">@style/Widget.Fiestas.Button</item>

    </style>

    <!-- 🎯 THEME FINAL -->
    <style name="Theme.FiestasAsturiasApp" parent="Base.Theme.FiestasAsturiasApp" />

    <!-- 🔘 BOTONES PRO -->
    <style name="Widget.Fiestas.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
    </style>

</resources>